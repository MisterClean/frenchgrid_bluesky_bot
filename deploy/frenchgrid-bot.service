[Unit]
Description=French electricity grid comparison bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=frenchgrid-bot
Group=frenchgrid-bot
WorkingDirectory=/var/lib/frenchgrid-bot
EnvironmentFile=/etc/frenchgrid-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/frenchgrid-bot/current/.venv/bin/python /opt/frenchgrid-bot/current/src/main.py
Restart=on-failure
RestartSec=60
UMask=0077
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/frenchgrid-bot

[Install]
WantedBy=multi-user.target
